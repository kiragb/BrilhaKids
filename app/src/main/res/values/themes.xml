<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. Tema principal da aplicação -->
    <!-- 1. Tema principal da aplicação -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="colorPrimary">#D50326</item>
        <item name="colorPrimaryVariant">#B2021E</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#F48FB1</item>
        <item name="colorControlActivated">#D50326</item>

        <!-- ADICIONE ESTAS LINHAS AQUI EMBAIXO: -->
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Isso ajuda a remover a sombra padrão -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- 2. Tema da Splash Screen -->
    <style name="Theme.BrilhaKids.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowSplashScreenBackground">@null</item>
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@null</item>
    </style>

    <!-- 3. Estilo para o arredondamento (Efeito Pílula de 50%) -->
    <style name="ShapeAppearanceOverlay.App.CornerSize50_Kids" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- 4. Estilo para o Texto do Menu (Fonte Adigianaui) -->
    <style name="NavDrawerText_Kids" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/adigianaui</item>
        <item name="fontFamily">@font/adigianaui</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>




</resources>