<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFAE7">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFAE7"
            android:padding="24dp">



            <ImageView
                android:id="@+id/logo"
                android:layout_width="wrap_content"
                android:layout_height="90dp"
                android:layout_marginTop="16dp"
                android:contentDescription="Logo BrilhaKids"
                android:src="@drawable/logo_brilhakids"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toEndOf="@id/menuIcon"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/fundo_laranja"
                android:layout_width="365dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/fundo_laranja"
                android:paddingBottom="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/logo">

                <TextView
                    android:id="@+id/tvBemVindo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/adigianaui"
                    android:text="Fale Conosco"
                    android:textColor="#085e9d"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvDescricao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/adigianaui"
                    android:gravity="center"
                    android:text="Tem alguma dúvida? Preencha o\nformulário abaixo e fale conosco :)"
                    android:textColor="#444444"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBemVindo" />

                <TextView
                    android:id="@+id/tvConecte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/adigianaui"
                    android:text="Conecte-se"
                    android:textColor="#085e9d"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDescricao" />

                <EditText
                    android:id="@+id/Nome"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bd_azulciano"
                    android:fontFamily="@font/adigianaui"
                    android:gravity="center"
                    android:hint="Nome"
                    android:padding="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvConecte" />

                <EditText
                    android:id="@+id/Email"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bd_azulciano"
                    android:fontFamily="@font/adigianaui"
                    android:gravity="center"
                    android:hint="E-mail"
                    android:padding="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/Nome" />

                <EditText
                    android:id="@+id/telefone"
                    android:layout_width="280dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bd_azulciano"
                    android:fontFamily="@font/adigianaui"
                    android:gravity="center"
                    android:hint="Telefone"
                    android:inputType="phone"
                    android:padding="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/Email" />

                <EditText
                    android:id="@+id/comentario"
                    android:layout_width="280dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bd_azulciano"
                    android:fontFamily="@font/adigianaui"
                    android:gravity="top|center_horizontal"
                    android:hint="Comentário"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/telefone" />

                <Button
                    android:id="@+id/btnCadastrar"
                    android:layout_width="200dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="#085e9d"
                    android:fontFamily="@font/adigianaui"
                    android:text="Enviar"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/comentario" />

                <ImageView
                    android:id="@+id/mensagem"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/mensagens"
                    app:layout_constraintBottom_toBottomOf="@+id/tvBemVindo"
                    app:layout_constraintEnd_toStartOf="@+id/tvBemVindo"
                    app:layout_constraintTop_toTopOf="@+id/tvBemVindo" />

                <ImageView
                    android:id="@+id/logofim"
                    android:layout_width="200dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="24dp"
                    android:contentDescription="Logo BrilhaKids"
                    android:src="@drawable/logo_brilhakids"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnCadastrar" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>