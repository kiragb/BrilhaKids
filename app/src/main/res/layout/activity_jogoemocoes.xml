<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="#FFFAE7">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- Menu e Logo -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logo"
            app:layout_constraintVertical_bias="0.0"
            tools:layout_editor_absoluteX="54dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/fundo_laranja"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Título -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/adigianaui"
                    android:text="Jogo das Emoções"
                    android:textColor="#b0890b"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp"
                    android:fontFamily="@font/adigianaui"
                    android:gravity="center"
                    android:text="Este brinquedo ajudará o pequeno a formar e interpretar reações e sentimentos!"
                    android:textColor="#fa500c"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- MATERIAIS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_amarelo_arredondado"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="#FFFFFF"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/jogo_emocoes1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/adigianaui"
                        android:gravity="center"
                        android:text="MATERIAIS: Placa de papelão, folhas de EVA, tesoura, caneta, bandeja de isopor, cola quente e velcro."
                        android:textColor="#000000"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PASSO 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_azul_arredondado"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="#FFFFFF"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/jogo_emocoes2" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/adigianaui"
                        android:gravity="center"
                        android:text="PASSO 1: Encapre a placa de papelão com uma folha de EVA (ou papel colorido) para deixá-la alegre."
                        android:textColor="#000000"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PASSO 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_rosa_arredondado"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="#FFFFFF"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/jogo_emocoes3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/adigianaui"
                        android:gravity="center"
                        android:text="PASSO 2: Pegue um outro EVA para desenhar o rosto do nosso personagem.
                        Depois de desenha-lo, recorte-o e cole-o na placa de papelão."
                        android:textColor="#000000"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PASSO 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_roxo_arredondado"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="#FFFFFF"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/jogo_emocoes4" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/adigianaui"
                        android:gravity="center"
                        android:text="PASSO 3: Corte pequenos quadrados de velcro e cole-os no rosto."
                        android:textColor="#000000"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- RESULTADO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_verde_arredondado"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="#FFFFFF"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/jogo_emocoes6" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/adigianaui"
                        android:gravity="center"
                        android:text="RESULTADO"
                        android:textColor="#260066"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/adigianaui"
                        android:gravity="center"
                        android:text="Brinquedo finalizado! Agora você pode desenhar vários tipos de expressões para ensinar as diferentes emoções que as pessoas têm."
                        android:textColor="#000000"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/checkboxConcluidoEmocoes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_gravity="center"
                        android:buttonTint="#260066"
                        android:fontFamily="@font/adigianaui"
                        android:text="Marcar como concluído"
                        android:textColor="#260066"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>


                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="40dp"
                    android:src="@drawable/logo_brilhakids" />

            </LinearLayout>
        </ScrollView>

        <ImageView
            android:id="@+id/menuIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/ic_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/logo_brilhakids"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#EBF0EB"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_drawer_logged"
        app:itemIconTint="#01420a"
        app:itemTextColor="#01420a"
        app:itemTextAppearance="@style/NavDrawerText_Kids" />

</androidx.drawerlayout.widget.DrawerLayout>