<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout_ajuda"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFAE7">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_ajuda"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Cabeçalho Laranja -->
        <View
            android:id="@+id/headerBackground"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/header_gradient_rounded"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Ícone do Menu -->
        <ImageView
            android:id="@+id/btnMenuAjuda"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="45dp"
            android:src="@drawable/ic_menu"
            app:tint="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTituloAjuda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Central de Ajuda"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:fontFamily="@font/adigianaui"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/headerBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/headerBackground"
            app:layout_constraintVertical_bias="0.6" />

        <ScrollView
            android:id="@+id/scrollAjuda"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerBackground">

            <LinearLayout
                android:id="@+id/containerCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Card 1: Como Usar -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardComoUsar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="15dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="15dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="15dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/ideia" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="15dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Como explorar o App?"
                                android:textStyle="bold"
                                android:textColor="#2E0084"
                                android:fontFamily="@font/adigianaui"
                                android:textSize="18sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Entenda o que significa cada cor."
                                android:textColor="#45404f"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card 2: Progresso -->
                <!-- Card 2: Espaço dos Pais -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardEspacoPais"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="15dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="15dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="15dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/familia" /> <!-- Ou um ícone de família/engrenagem -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="15dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Espaço dos Pais"
                                android:textStyle="bold"
                                android:textColor="#005000"
                                android:fontFamily="@font/adigianaui"
                                android:textSize="18sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#45404f"
                                android:text="Dicas de segurança e uso do app."
                                android:textSize="14sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card 3: Fale Conosco -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFaleConoscoAjuda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="15dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="15dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="15dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/mensagens" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="15dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Falar com Suporte"
                                android:textStyle="bold"
                                android:textColor="#085E9D"
                                android:fontFamily="@font/adigianaui"
                                android:textSize="18sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Envie sua dúvida."
                                android:textColor="#45404f"
                                android:textSize="14sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <ImageView
                    android:id="@+id/ivLogoAjudaFinal"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/logo_brilhakids" />
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MENU LATERAL IDENTICO AO DA MAIN ACTIVITY -->

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#EBF0EB"
        app:headerLayout="@layout/drawer_header"
        app:menu="@menu/drawer_menu"
        app:itemTextAppearance="@style/NavDrawerText_Kids">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="50dp">

            <ImageView
                android:id="@+id/img_menina_menu"
                android:layout_width="280dp"
                android:layout_height="350dp"
                android:src="@drawable/menina_entrar"
                android:scaleType="fitCenter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_entrar_custom"
                android:layout_width="220dp"
                android:layout_height="60dp"
                android:text="Entrar no App"
                android:textAllCaps="false"
                android:fontFamily="@font/adigianaui"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#01420a"
                android:background="@drawable/bg_botao_gradiente"
                app:backgroundTint="@null"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_login"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="#01420a"
                app:elevation="4dp" />
        </LinearLayout>

        <include
            layout="@layout/nav_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>