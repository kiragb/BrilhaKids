<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="#FFFAE7">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/menuIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/ic_menu"
                android:contentDescription="Menu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/logo"
                android:layout_width="wrap_content"
                android:layout_height="90dp"
                android:layout_marginTop="16dp"
                android:contentDescription="Logo BrilhaKids"
                android:src="@drawable/logo_brilhakids"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toEndOf="@id/menuIcon"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/fundo_laranja"
                android:layout_width="365dp"
                android:layout_height="834dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/fundo_laranja"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/logo">

                <TextView
                    android:id="@+id/tvTituloPagina"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/adigianaui"
                    android:text="Jogos Manuais"
                    android:textColor="#FF5722"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- SEÇÃO QUEBRA-CABEÇA -->
                <ImageView
                    android:id="@+id/cardQuebraCabeca"
                    android:layout_width="148dp"
                    android:layout_height="144dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/bg_azul_arredondado"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTituloPagina" />

                <ImageView
                    android:id="@+id/imageQuebraCabeca"
                    android:layout_width="121dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="60dp"
                    android:src="@drawable/quebra_cabeca"
                    app:layout_constraintEnd_toEndOf="@id/cardQuebraCabeca"
                    app:layout_constraintStart_toStartOf="@id/cardQuebraCabeca"
                    app:layout_constraintTop_toTopOf="@id/cardQuebraCabeca" />

                <TextView
                    android:id="@+id/tvQuebraCabeca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/adigianaui"
                    android:text="Quebra\nCabeça"
                    android:textAlignment="center"
                    android:textColor="#260066"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/imageQuebraCabeca"
                    app:layout_constraintStart_toStartOf="@id/cardQuebraCabeca"
                    app:layout_constraintEnd_toEndOf="@id/cardQuebraCabeca"
                    app:layout_constraintTop_toTopOf="@id/cardQuebraCabeca" />

                <!-- SEÇÃO ALFABETO DIVERTIDO -->
                <ImageView
                    android:id="@+id/cardAlfabeto"
                    android:layout_width="148dp"
                    android:layout_height="144dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_rosa_arredondado"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.078"
                    app:layout_constraintTop_toBottomOf="@id/cardQuebraCabeca" />

                <ImageView
                    android:id="@+id/imageAlfabeto"
                    android:layout_width="128dp"
                    android:layout_height="84dp"
                    android:layout_marginTop="60dp"
                    android:src="@drawable/alfabeto_divertido"
                    app:layout_constraintEnd_toEndOf="@id/cardAlfabeto"
                    app:layout_constraintStart_toStartOf="@id/cardAlfabeto"
                    app:layout_constraintTop_toTopOf="@id/cardAlfabeto" />

                <TextView
                    android:id="@+id/tvAlfabeto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/adigianaui"
                    android:text="Alfabeto\nDivertido"
                    android:textAlignment="center"
                    android:textColor="#B30000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/imageAlfabeto"
                    app:layout_constraintStart_toStartOf="@id/cardAlfabeto"
                    app:layout_constraintEnd_toEndOf="@id/cardAlfabeto"
                    app:layout_constraintTop_toTopOf="@id/cardAlfabeto" />

                <!-- SEÇÃO JOGO DAS EMOÇÕES -->
                <ImageView
                    android:id="@+id/cardEmocoes"
                    android:layout_width="148dp"
                    android:layout_height="144dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/bg_amarelo_arredondado"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.889"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvTituloPagina" />

                <ImageView
                    android:id="@+id/imageEmocoes"
                    android:layout_width="111dp"
                    android:layout_height="72dp"
                    android:src="@drawable/jogo_emocoes"
                    app:layout_constraintBottom_toBottomOf="@id/cardEmocoes"
                    app:layout_constraintEnd_toEndOf="@id/cardEmocoes"
                    app:layout_constraintStart_toStartOf="@id/cardEmocoes"
                    app:layout_constraintTop_toTopOf="@id/cardEmocoes"
                    app:layout_constraintVertical_bias="0.836" />

                <TextView
                    android:id="@+id/tvEmocoes"
                    android:layout_width="97dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/adigianaui"
                    android:text="Jogo das\nEmoções"
                    android:textAlignment="center"
                    android:textColor="#663300"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@id/cardEmocoes"
                    app:layout_constraintHorizontal_bias="0.47"
                    app:layout_constraintStart_toStartOf="@id/cardEmocoes"
                    app:layout_constraintTop_toTopOf="@id/cardEmocoes"
                    app:layout_constraintVertical_bias="0.1" />

                <!-- SEÇÃO ANTECESSORES -->
                <ImageView
                    android:id="@+id/cardAntecessores"
                    android:layout_width="148dp"
                    android:layout_height="144dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_verde_arredondado"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardEmocoes" />

                <ImageView
                    android:id="@+id/imageAntecessores"
                    android:layout_width="114dp"
                    android:layout_height="83dp"
                    android:layout_marginTop="56dp"
                    android:src="@drawable/antecessores"
                    app:layout_constraintEnd_toEndOf="@id/cardAntecessores"
                    app:layout_constraintHorizontal_bias="0.558"
                    app:layout_constraintStart_toStartOf="@id/cardAntecessores"
                    app:layout_constraintTop_toTopOf="@id/cardAntecessores" />

                <TextView
                    android:id="@+id/tvAntecessores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/adigianaui"
                    android:text="Antecessores e\nSucessores"
                    android:textAlignment="center"
                    android:textColor="#005000"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/cardAntecessores"
                    app:layout_constraintStart_toStartOf="@id/cardAntecessores"
                    app:layout_constraintEnd_toEndOf="@id/cardAntecessores"
                    app:layout_constraintTop_toTopOf="@id/cardAntecessores"
                    app:layout_constraintVertical_bias="0.111" />

                <!-- SEÇÃO JOGO DA VELHA -->
                <ImageView
                    android:id="@+id/cardVelha"
                    android:layout_width="148dp"
                    android:layout_height="144dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="296dp"
                    android:background="@drawable/bg_roxo_arredondado"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardAntecessores"
                    app:layout_constraintVertical_bias="1.0" />

                <ImageView
                    android:id="@+id/imageVelha"
                    android:layout_width="110dp"
                    android:layout_height="88dp"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/jogo_da_velha"
                    app:layout_constraintBottom_toBottomOf="@id/cardVelha"
                    app:layout_constraintEnd_toEndOf="@id/cardVelha"
                    app:layout_constraintStart_toStartOf="@id/cardVelha"
                    app:layout_constraintHorizontal_bias="0.50" />

                <TextView
                    android:id="@+id/tvVelha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/adigianaui"
                    android:text="Jogo da\nVelha"
                    android:textAlignment="center"
                    android:textColor="#2e0084"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/cardVelha"
                    app:layout_constraintEnd_toEndOf="@+id/cardVelha"
                    app:layout_constraintHorizontal_bias="0.493"
                    app:layout_constraintStart_toStartOf="@+id/cardVelha"
                    app:layout_constraintTop_toTopOf="@+id/cardVelha"
                    app:layout_constraintVertical_bias="0.0" />

                <!-- SEÇÃO CAIXA CURIOSA -->
                <ImageView
                    android:id="@+id/cardCaixa"
                    android:layout_width="148dp"
                    android:layout_height="144dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="136dp"
                    android:background="@drawable/bg_verdeescuro_arredondado"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardVelha"
                    app:layout_constraintVertical_bias="1.0" />

                <ImageView
                    android:id="@+id/imageCaixa"
                    android:layout_width="117dp"
                    android:layout_height="75dp"
                    android:src="@drawable/caixa"
                    app:layout_constraintBottom_toBottomOf="@+id/cardCaixa"
                    app:layout_constraintEnd_toEndOf="@+id/cardCaixa"
                    app:layout_constraintHorizontal_bias="0.482"
                    app:layout_constraintStart_toStartOf="@+id/cardCaixa"
                    app:layout_constraintTop_toTopOf="@+id/tvCaixa"
                    app:layout_constraintVertical_bias="0.86" />

                <TextView
                    android:id="@+id/tvCaixa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/adigianaui"
                    android:text="Caixa\nCuriosa"
                    android:textAlignment="center"
                    android:textColor="#45a102"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/cardCaixa"
                    app:layout_constraintEnd_toEndOf="@+id/cardCaixa"
                    app:layout_constraintHorizontal_bias="0.52"
                    app:layout_constraintStart_toStartOf="@+id/cardCaixa"
                    app:layout_constraintTop_toTopOf="@+id/cardCaixa"
                    app:layout_constraintVertical_bias="0.101" />

                <!-- SEÇÃO JOGO DAS SÍLABAS -->
                <ImageView
                    android:id="@+id/cardSilabas"
                    android:layout_width="148dp"
                    android:layout_height="144dp"
                    android:layout_marginEnd="200dp"
                    android:background="@drawable/bg_amareloescuro"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardAntecessores"
                    app:layout_constraintVertical_bias="0.054" />

                <ImageView
                    android:id="@+id/imageSilabas"
                    android:layout_width="129dp"
                    android:layout_height="93dp"
                    android:src="@drawable/jogo_das_silabas"
                    app:layout_constraintBottom_toBottomOf="@+id/cardSilabas"
                    app:layout_constraintEnd_toEndOf="@id/cardSilabas"
                    app:layout_constraintHorizontal_bias="0.473"
                    app:layout_constraintStart_toStartOf="@id/cardSilabas"
                    app:layout_constraintTop_toTopOf="@id/cardSilabas"
                    app:layout_constraintVertical_bias="1.0" />

                <TextView
                    android:id="@+id/tvSilabas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/adigianaui"
                    android:text="Jogo das\nSílabas"
                    android:textAlignment="center"
                    android:textColor="#f78012"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/cardSilabas"
                    app:layout_constraintEnd_toEndOf="@+id/cardSilabas"
                    app:layout_constraintHorizontal_bias="0.523"
                    app:layout_constraintStart_toStartOf="@+id/cardSilabas"
                    app:layout_constraintTop_toTopOf="@+id/cardSilabas"
                    app:layout_constraintVertical_bias="0.076" />

                <!-- SEÇÃO JOGO DAS DECISÕES -->
                <ImageView
                    android:id="@+id/cardDecisoes"
                    android:layout_width="148dp"
                    android:layout_height="144dp"
                    android:layout_marginEnd="200dp"
                    android:background="@drawable/bg_fundo_cinza"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardSilabas"
                    app:layout_constraintVertical_bias="0.105" />

                <ImageView
                    android:id="@+id/imageDecisoes"
                    android:layout_width="126dp"
                    android:layout_height="89dp"
                    android:src="@drawable/decisoes"
                    app:layout_constraintBottom_toBottomOf="@+id/cardDecisoes"
                    app:layout_constraintEnd_toEndOf="@+id/cardDecisoes"
                    app:layout_constraintHorizontal_bias="0.454"
                    app:layout_constraintStart_toStartOf="@+id/cardDecisoes"
                    app:layout_constraintTop_toTopOf="@+id/cardDecisoes"
                    app:layout_constraintVertical_bias="1.0" />

                <TextView
                    android:id="@+id/tvDecisoes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/adigianaui"
                    android:text="Jogo das\nDecisões"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/cardDecisoes"
                    app:layout_constraintEnd_toEndOf="@+id/cardDecisoes"
                    app:layout_constraintHorizontal_bias="0.48"
                    app:layout_constraintStart_toStartOf="@+id/cardDecisoes"
                    app:layout_constraintTop_toTopOf="@+id/cardDecisoes"
                    app:layout_constraintVertical_bias="0.101" />

                <!-- LOGO FINAL -->
                <ImageView
                    android:id="@+id/logofim"
                    android:layout_width="228dp"
                    android:layout_height="45dp"
                    android:contentDescription="Logo BrilhaKids"
                    android:src="@drawable/logo_brilhakids"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.569"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvTituloPagina"
                    app:layout_constraintVertical_bias="0.979" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#EBF0EB"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_drawer_logged"

        app:itemBackground="@drawable/menu_item_gradient"
        app:itemIconTint="#FFFFFF"
        app:itemTextColor="#01420a"
        app:itemShapeFillColor="@null"
        app:itemHorizontalPadding="26dp"
        app:itemIconPadding="22dp"
        app:itemVerticalPadding="14dp"
        app:itemTextAppearance="@style/NavDrawerText_Kids">

        <include
            layout="@layout/nav_footer_lapis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="40dp"/>

    </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>