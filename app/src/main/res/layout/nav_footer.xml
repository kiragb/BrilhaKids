<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="80dp">

    <!-- Item Sobre -->
    <LinearLayout
        android:id="@+id/nav_about_footer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <ImageView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/ic_about_kids"            android:contentDescription="Sobre" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sobre o BrilhaKids"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/adigianaui"
            android:textColor="#2DA33E"
            android:textSize="21sp" />
    </LinearLayout>

    <!-- Item Ajuda -->
    <LinearLayout
        android:id="@+id/nav_help_footer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <ImageView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/ic_help_kids"            android:contentDescription="Ajuda" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajuda"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/adigianaui"
            android:textColor="#2DA33E"
            android:textSize="21sp" />
    </LinearLayout>
</LinearLayout>