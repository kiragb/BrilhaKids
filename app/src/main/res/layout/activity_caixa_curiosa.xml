<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Antecessores">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFAE7">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Ícone do Menu -->
            <ImageView
                android:id="@+id/menuIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="40dp"
                android:contentDescription="Menu"
                android:src="@drawable/ic_menu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Logo Superior -->
            <ImageView
                android:id="@+id/logo"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginTop="10dp"
                android:contentDescription="Logo BrilhaKids"
                android:src="@drawable/logo_brilhakids"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:fillViewport="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/logo">

                <LinearLayout
                    android:id="@+id/container_tutorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:background="@drawable/fundo_laranja"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Título da Página -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/adigianaui"
                        android:text="Caixa Curiosa"
                        android:textColor="#0aab88"
                        android:gravity="center"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="24dp"
                        android:fontFamily="@font/adigianaui"
                        android:gravity="center"
                        android:textColor="#06c49b"
                        android:text="Este brinquedo tem tem o intuito de ajudar as crianças a melhorarem seu tato e sua recepção de uma informação por meio do tato "
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- SEÇÃO: MATERIAIS (Card Azul) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_rosa_arredondado"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- Ajustado para fitCenter e com fundo branco para destaque -->
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:background="#FFFFFF"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/caixa1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/adigianaui"
                            android:gravity="center"
                            android:text="MATERIAIS: Caixa de papelão, EVA, tinta guache, pincel, fita adesiva, venda para os olhos"
                            android:textColor="#000000"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- SEÇÃO: PASSO 1 (Card Rosa) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_verdeescuro_arredondado"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:background="#FFFFFF"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/caixa2" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/adigianaui"
                            android:gravity="center"
                            android:text="PASSO 1:  Pinte o exterior d acaixa com uma cor de sua preferência"
                            android:textColor="#000000"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- SEÇÃO: PASSO 2 (Card Amarelo) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_roxoclaro"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:background="#FFFFFF"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/caixa3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/adigianaui"
                            android:gravity="center"
                            android:text="PASSO 2: Após a tinta seca, pinte sua mão com outra cor de tinta e marque ao redor da caixa para enfeita-la"
                            android:textColor="#000000"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- SEÇÃO: PASSO 3 (Card Amarelo) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_rosaclaro"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:background="#FFFFFF"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/caixa4" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/adigianaui"
                            android:gravity="center"
                            android:text="PASSO 3:  Coloque o papel EVA por dentro ca caixa"
                            android:textColor="#000000"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- SEÇÃO: RESULTADO (Card Verde) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_verbemclaro"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:background="#FFFFFF"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/caixa5" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/adigianaui"
                            android:gravity="center"
                            android:text="RESULTADO"
                            android:textColor="#260066"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/adigianaui"
                            android:gravity="center"
                            android:text="Coloque a venda no jogador, ao fazer isso leve sua mão a caixa e peça para ele apalpar o objeto que você colocou dentro da mesma. Lembre-se de recompensar a criança sempre que ela certar."
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <CheckBox
                            android:id="@+id/checkboxConcluidoCaixa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_gravity="center"
                            android:buttonTint="#260066"
                            android:fontFamily="@font/adigianaui"
                            android:text="Marcar como concluído"
                            android:textColor="#260066"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Logo de Rodapé -->
                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:src="@drawable/logo_brilhakids" />

                </LinearLayout>
            </ScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Menu Lateral (NavigationView) -->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigation_view"
            android:layout_width="290dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="#EBF0EB"
            app:headerLayout="@layout/nav_header"
            app:itemIconTint="#01420a"
            app:itemTextAppearance="@style/NavDrawerText_Kids"
            app:itemTextColor="#01420a"
            app:menu="@menu/menu_drawer_logged" />

    </androidx.drawerlayout.widget.DrawerLayout>
</androidx.constraintlayout.widget.ConstraintLayout>